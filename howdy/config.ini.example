# /etc/howdy/config.ini configuration snippet for HP Dragonfly Folio G3 IR Camera
#
# Paste these settings into your /etc/howdy/config.ini under the [video] section:

[video]
# Use the high-performance native libcamera IR streamer
recording_plugin = ir_libcamera
ir_grab_path = /usr/libexec/howdy/ir-grab
ir_camera = \_SB_.PC00.LNK1

# Sensor gain and exposure (calibrated for high contrast in low/zero light)
ir_gain = 128
ir_exposure = 2000
ir_black_level = 64
ir_normalize = percentile
ir_clahe = false

# LM3643 IR Strobe LED control
flash_path = /sys/class/leds/lm3643:torch/brightness
flash_brightness = 60

# Authentication timeout and darkness threshold
timeout = 10
dark_threshold = 85
certainty = 3.5

# Disable old OpenCV / GStreamer pipeline
# device_path = libcamerasrc ...

[tof_antispoof]
# Enable ST VL53L5 8x8 ToF 3D depth and presence verification before face matching
# Prevents spoofing using printed photos, tablet screens, or phones
enabled = true
# Seated envelope: only authenticate when person is between min and max cm
min_distance_cm = 30
max_distance_cm = 85
# Minimum 3D depth curvature standard deviation in cm across valid face zones
# Flat surfaces (photos/screens) have < 1.0 cm variance; real human heads have >= 2.0 cm
min_depth_variance_cm = 1.8
# Require Intel ISH Biometric Presence flag (1 = detected)
require_presence = true
# Display anti-spoof warning in terminal when triggered
warn_on_fail = true
